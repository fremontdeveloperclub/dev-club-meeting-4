{"version":1,"owner":"fremontdeveloperclub","repo":"dev-club-meeting-4","branch":"main","login":"shaitz612-coder","baseHead":"b3956dc4af4b4977fc6a574da55cc10aebef493d","head":"b3956dc4af4b4977fc6a574da55cc10aebef493d","pendingCommits":[],"working":[["index.html","<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"description\" content=\"A few notes about fish, where they live, and how they breathe.\">\n    <title>Fish Notes</title>\n    <link rel=\"stylesheet\" href=\"styles.css\">\n  </head>\n  <body>\n    <header class=\"site-header page-width\">\n      <p class=\"wordmark\">Fish Notes</p>\n    </header>\n\n    <main class=\"page-width\">\n      <section class=\"intro\" aria-labelledby=\"intro-title\">\n        <p class=\"subtitle\">Oceans, rivers, lakes, and ponds</p>\n        <!-- TODO 1: Give this fish website a new heading. -->\n        <h1 id=\"intro-title\">Fish are cool</h1>\n        <!-- TODO 2: Rewrite this introduction to explain why you find fish interesting. -->\n        <p>Fish come in all sorts of shapes, sizes, and colors. Some live on coral reefs, while others spend their lives in a quiet pond. Here are a few worth getting to know.</p>\n      </section>\n\n      <section class=\"fish-note\" aria-labelledby=\"fact-title\">\n        <h2 id=\"fact-title\">How do fish breathe?</h2>\n        <p>Most fish use gills to take oxygen from the water. As water passes over the gills, oxygen moves into the fish's blood.</p>\n      </section>\n\n      <section class=\"fish\" aria-labelledby=\"fish-title\">\n        <h2 id=\"fish-title\">A few familiar fish</h2>\n        <ul class=\"fish-list\">\n          <li><strong>Clownfish</strong> are best known for their orange color and white stripes.</li>\n          <li><strong>Rainbow trout</strong> have a pink stripe running along their sides.</li>\n          <li><strong>Goldfish</strong> are freshwater fish often kept in ponds and aquariums.</li>\n        </ul>\n      </section>\n    </main>\n\n    <footer class=\"site-footer page-width\">\n      <p>Fish Notes</p>\n    </footer>\n  </body>\n</html>\n"]],"staged":[],"extra":{"aiMessages":[],"harnessMessages":[],"harnessTodos":[],"agentSessions":[],"sessionId":"79cb24b6-199d-4ad8-ae38-46d720db542e","activeTab":"index.html","openTabs":["index.html"],"expandedFolders":[],"contextFiles":[],"directories":[]}}